# Example environment variables for the backend
# Copy this file to `.env` and fill in the values before running the service.

# OpenAI (or other LLM provider) API key
OPENAI_API_KEY=your_openai_api_key_here

# Local Chroma DB path (relative to backend/)
CHROMA_DB_PATH=./chroma_data/chroma.sqlite3

# Server host and port
HOST=127.0.0.1
PORT=8000

# Optional: set to true for debug / verbose logs
DEBUG=true
